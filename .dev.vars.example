DEV_MODE=true
APP_ORIGIN=http://localhost:8787
DATA_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# 使用 npm run password:setup -- --local 生成；不填原密码
PASSWORD_CREDENTIAL=
# GitHub App 的 Client ID / Secret，不是传统 OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPO=zxymiku/guet-food-share
GITHUB_ANDROID_REPO_ID=1439394710
GITHUB_WEB_REPO_ID=1439394807
MEDIA_REPO=zxymiku/guet-food-share-media
FEEDBACK_WEB_REPO=zxymiku/guet-food-share-web
DISPATCH_GITHUB_TOKEN=
MEDIA_GITHUB_TOKEN=
FEEDBACK_GITHUB_TOKEN=
REVIEWER_GITHUB_IDS=
INTAKE_SECRET=
PUBLISH_SECRET=
# 开发者公共底图：仅运营方配置；不要填写访问者的个人 Key。
# 生产请使用 Worker Secrets；安全密钥不返回客户端。
AMAP_PUBLIC_MAP_ENABLED=false
AMAP_PUBLIC_WEB_KEY=
AMAP_PUBLIC_SECURITY_JS_CODE=
AMAP_PUBLIC_ANDROID_KEY=
AMAP_PUBLIC_PROXY_DAILY_LIMIT=5000
AMAP_PUBLIC_PROXY_IP_HOURLY_LIMIT=200
